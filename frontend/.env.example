# Copy to `.env.local` to override. Used at build time (Vite embeds `VITE_*`).
# Dev default in `.env.development` points at local FastAPI; E2E mocks that origin.
VITE_API_URL=http://localhost:8000
# Backend demo wallet (`GET /accounts/{id}`). Default 1 with docker-compose seed env.
VITE_ACCOUNT_ID=1

# Production example (set in Vercel project environment variables):
# VITE_API_URL=https://api.example.com
