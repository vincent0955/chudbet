# Local FastAPI (docker compose or uvicorn). Override in `.env.local` if needed.
# E2E mocks intercept http://localhost:8000 directly (see e2e/support/mockApi.ts).
VITE_API_URL=http://localhost:8000
# Matches backend CHUDBET_DEMO_ACCOUNT_ID when compose seeds CHUDBET_SEED_DEMO_WALLET.
VITE_ACCOUNT_ID=1
