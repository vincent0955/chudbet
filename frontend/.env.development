# Dev server proxies API routes to FastAPI (see vite.config.ts). Leave VITE_API_URL unset
# so the browser uses same-origin requests and avoids CORS when Vite picks another port.
# To bypass the proxy: VITE_API_URL=http://localhost:8000
# Matches backend CHUDBET_DEMO_ACCOUNT_ID when compose seeds CHUDBET_SEED_DEMO_WALLET.
VITE_ACCOUNT_ID=1
