# Copy to `.env.prod` on the VM and set real values.

# Domain and TLS
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Postgres credentials
POSTGRES_USER=chudbet_prod
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=chudbet

# Backend
CHUDBET_CORS_ORIGINS=https://your-frontend.vercel.app,https://www.yourdomain.com
CHUDBET_SEED_DEMO_WALLET=false
CHUDBET_DEMO_ACCOUNT_ID=1
CHUDBET_DEMO_WALLET_CENTS=10000000

# Worker
NBA_SEASON=2025-26
WORKER_INGEST_INTERVAL_SEC=900
WORKER_SETTLE_INTERVAL_SEC=120
WORKER_SCOREBOARD_PAST_DAYS=5
WORKER_REFRESH_OPEN_WAGER_GAMES_BEFORE_SETTLE=true
WORKER_SCOREBOARD_DAYS=3
WORKER_SKIP_ROSTERS=true
WORKER_SKIP_GAMES=true
# Optional:
# WORKER_MAX_GAMES=80

# Optional: HTTP(S) proxy for NBA ingestion (e.g. Decodo ISP). Pick ONE port (10001–10010). Never commit real passwords.
# URL-encode special characters in USER/PASS if the client fails to connect (e.g. use %7E for ~).
# HTTP_PROXY=http://USER:PASS@isp.decodo.com:10001
# HTTPS_PROXY=http://USER:PASS@isp.decodo.com:10001
# NO_PROXY=postgres,backend,localhost,127.0.0.1
